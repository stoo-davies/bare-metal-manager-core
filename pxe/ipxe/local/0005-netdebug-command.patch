+FILE_LICENCE ( GPL2_OR_LATER_OR_UBDL );
+FILE_SECBOOT ( PERMITTED );
+
+#include <stdio.h>
+#include <string.h>
+#include <errno.h>
+#include <getopt.h>
+#include <ipxe/command.h>
+#include <ipxe/parseopt.h>
+#include <ipxe/timer.h>
+
+/** @file
+ *
+ * Runtime control of compiled-in network debugging.
+ */
+
+/* Weak references leave unused protocols and firmware drivers unlinked. */
+#define NETDEBUG_DECLARE( object ) \
+	extern char __debug_disable(object) __attribute__ (( weak ))
+
+NETDEBUG_DECLARE ( tcp );
+NETDEBUG_DECLARE ( ipv4 );
+NETDEBUG_DECLARE ( arp );
+NETDEBUG_DECLARE ( neighbour );
+NETDEBUG_DECLARE ( retry );
+NETDEBUG_DECLARE ( netdevice );
+NETDEBUG_DECLARE ( nii );
+NETDEBUG_DECLARE ( snp );
+NETDEBUG_DECLARE ( snpnet );
+NETDEBUG_DECLARE ( tls );
+NETDEBUG_DECLARE ( httpconn );
+NETDEBUG_DECLARE ( httpcore );
+
+static char * const netdebug_masks[] = {
+	&__debug_disable(tcp),
+	&__debug_disable(ipv4),
+	&__debug_disable(arp),
+	&__debug_disable(neighbour),
+	&__debug_disable(retry),
+	&__debug_disable(netdevice),
+	&__debug_disable(nii),
+	&__debug_disable(snp),
+	&__debug_disable(snpnet),
+	&__debug_disable(tls),
+	&__debug_disable(httpconn),
+	&__debug_disable(httpcore),
+};
+
+struct netdebug_options {};
+static struct option_descriptor netdebug_opts[] = {};
+static struct command_descriptor netdebug_cmd =
+	COMMAND_DESC ( struct netdebug_options, netdebug_opts, 1, 1, "on|off" );
+
+static int netdebug_exec ( int argc, char **argv ) {
+	struct netdebug_options opts;
+	unsigned int i;
+	int enabled;
+	int rc;
+
+	if ( ( rc = parse_options ( argc, argv, &netdebug_cmd, &opts ) ) != 0 )
+		return rc;
+
+	if ( strcmp ( argv[optind], "on" ) == 0 ) {
+		enabled = 1;
+	} else if ( strcmp ( argv[optind], "off" ) == 0 ) {
+		enabled = 0;
+	} else {
+		printf ( "Expected netdebug on|off\n" );
+		return -EINVAL;
+	}
+
+	for ( i = 0 ; i < ( sizeof ( netdebug_masks ) /
+			   sizeof ( netdebug_masks[0] ) ) ; i++ ) {
+		if ( netdebug_masks[i] )
+			*netdebug_masks[i] = ( enabled ? 0 : ~0 );
+	}
+
+	printf ( "Network debugging %s at %ld ticks\n", argv[optind], currticks() );
+	return 0;
+}
+
+COMMAND ( netdebug, netdebug_exec );
