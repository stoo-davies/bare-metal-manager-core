Runtime control of NICo network diagnostics

Add netdebug on|off to toggle the compiled-in network debug masks. Weak
references avoid pulling unused drivers into images that do not include them.
The build selects maximum debug levels and starts with those levels disabled;
the embedded script enables them only for the boot-instruction download.

Apply after 0004-http-ipv6-source.patch.

--- a/src/config/config.c
+++ b/src/config/config.c
@@ -276,6 +276,9 @@
 #ifdef NEIGHBOUR_CMD
 REQUIRE_OBJECT ( neighbour_cmd );
 #endif
+#ifdef NETDEBUG_CMD
+REQUIRE_OBJECT ( netdebug_cmd );
+#endif
 #ifdef PING_CMD
 REQUIRE_OBJECT ( ping_cmd );
 #endif
--- a/src/include/ipxe/errfile.h
+++ b/src/include/ipxe/errfile.h
@@ -372,6 +372,7 @@
 #define ERRFILE_linux_smbios	      ( ERRFILE_OTHER | 0x001a0000 )
 #define ERRFILE_lotest		      ( ERRFILE_OTHER | 0x001b0000 )
 #define ERRFILE_config_cmd	      ( ERRFILE_OTHER | 0x001c0000 )
+#define ERRFILE_netdebug_cmd           ( ERRFILE_OTHER | 0x006f0000 )
 #define ERRFILE_ifmgmt_cmd	      ( ERRFILE_OTHER | 0x001d0000 )
 #define ERRFILE_fcmgmt_cmd	      ( ERRFILE_OTHER | 0x001e0000 )
 #define ERRFILE_gdbstub_cmd	      ( ERRFILE_OTHER | 0x001f0000 )
--- /dev/null
+++ b/src/hci/commands/netdebug_cmd.c
@@ -0,0 +1,95 @@
